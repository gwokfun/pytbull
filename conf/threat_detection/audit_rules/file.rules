# File Monitoring Rules for Auditd
# These rules should be loaded into auditd using: auditctl -R file.rules

# Monitor sensitive system files
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/group -p wa -k group_changes
-w /etc/gshadow -p wa -k gshadow_changes
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d/ -p wa -k sudoers_changes

# Monitor SSH configuration
-w /etc/ssh/sshd_config -p wa -k sshd_config_changes
-w /root/.ssh -p wa -k root_ssh_changes
-w /home -p wa -k home_ssh_changes

# Monitor PAM configuration
-w /etc/pam.d/ -p wa -k pam_changes
-w /etc/security/ -p wa -k security_config_changes

# Monitor system binaries
-w /usr/bin -p wa -k bin_changes
-w /usr/sbin -p wa -k sbin_changes
-w /bin -p wa -k bin_changes
-w /sbin -p wa -k sbin_changes

# Monitor libraries
-w /lib -p wa -k lib_changes
-w /lib64 -p wa -k lib64_changes
-w /usr/lib -p wa -k lib_changes
-w /usr/lib64 -p wa -k lib64_changes

# Monitor cron jobs
-w /etc/cron.d -p wa -k cron_changes
-w /etc/cron.daily -p wa -k cron_changes
-w /etc/cron.hourly -p wa -k cron_changes
-w /etc/cron.monthly -p wa -k cron_changes
-w /etc/cron.weekly -p wa -k cron_changes
-w /etc/crontab -p wa -k cron_changes
-w /var/spool/cron -p wa -k cron_changes

# Monitor systemd services
-w /etc/systemd/ -p wa -k systemd_changes
-w /lib/systemd/ -p wa -k systemd_changes

# Monitor kernel modules
-w /lib/modules -p wa -k kernel_module_changes
-a always,exit -F arch=b64 -S init_module -S delete_module -k kernel_module_load
-a always,exit -F arch=b32 -S init_module -S delete_module -k kernel_module_load

# Monitor file operations (open, read, write, delete)
-a always,exit -F arch=b64 -S open -S openat -S openat2 -k file_open
-a always,exit -F arch=b32 -S open -S openat -k file_open
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -k file_delete
-a always,exit -F arch=b32 -S unlink -S unlinkat -S rename -S renameat -k file_delete
